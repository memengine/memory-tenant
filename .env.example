# Tenant dashboard local configuration
# Copy this file to .env.local and replace Clerk values with your tenant-dashboard app keys.

# Backend API used by the tenant dashboard.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Consent app used by Memory Passport links and playground consent demo.
NEXT_PUBLIC_CONSENT_BASE_URL=http://localhost:3001

# Marketing app used by pricing/upgrade navigation.
NEXT_PUBLIC_MARKETING_BASE_URL=http://localhost:3002
NEXT_PUBLIC_UPGRADE_URL=http://localhost:3002/pricing

# Clerk authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Local development helper for small machine-clock differences.
CLERK_CLOCK_SKEW_MS=10000